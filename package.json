{
  "name": "jev-llm",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web \"tsx watch --env-file=.env server/index.ts\" \"vite\"",
    "dev:api": "tsx watch --env-file=.env server/index.ts",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "node --import tsx --test \"server/**/*.test.ts\""
  },
  "dependencies": {
    "@hono/node-server": "^2.1.4",
    "hono": "^4.13.13",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
